# Obrigatorio quando DJANGO_DEBUG=False. Troque antes de subir.
DJANGO_SECRET_KEY=changeme-use-a-secure-random-string
DJANGO_ENV=production
DJANGO_DEBUG=False
# O docker-stack.yml interpola ${DOMAIN} nos LABELS do Traefik, mas env_file
# NÃO expande variáveis dentro do próprio .env — troque pelo domínio real
# (o mesmo valor de DOMAIN, escrito por extenso nas duas linhas abaixo).
# O ponto inicial em .{DOMINIO} cobre subdomínios; localhost/127.0.0.1 são
# obrigatórios para o HEALTHCHECK do container (bate em localhost:8000).
DJANGO_ALLOWED_HOSTS=novo.tonicoimbra.com,.novo.tonicoimbra.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://novo.tonicoimbra.com,https://*.novo.tonicoimbra.com

# HTTPS/proxy. Em producao, mantenha os defaults seguros ou ajuste no proxy.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_TRUST_X_FORWARDED_PROTO=True
DJANGO_USE_X_FORWARDED_HOST=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# PostgreSQL (produção / Docker Compose)
DATABASE_URL=postgresql://noivas:${POSTGRES_PASSWORD}@db:5432/noivas_cia
POSTGRES_DB=noivas_cia
POSTGRES_USER=noivas
POSTGRES_PASSWORD=troque-esta-senha

# Arquivos de mídia
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
STATIC_ROOT=/app/staticfiles
BACKUP_ROOT=/app/data/backups
HOST_PORT=8000
PORT=8000
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
USER_CREATOR_EMAILS=

# E-mail / redefinicao de senha
# Se EMAIL_HOST ficar vazio, o app usa console backend para nao falhar.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Noivas & Cia <no-reply@tonicoimbra.com>

# Evolution API / relatório diário por WhatsApp
# Em produção (Swarm), o nome interno do serviço é <stack>_evolution-api.
EVOLUTION_API_URL=http://noivaecia_evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=noivascia
WHATSAPP_SCHEDULER_ENABLED=1

# Deploy VPS — Docker Swarm + Traefik (docs/deploy/PRD-deploy.md)
DOMAIN=novo.tonicoimbra.com
ACME_EMAIL=
# htpasswd -nbB admin 'SENHA' — cole aqui com UM único '$' (o docker-stack.yml
# interpola a variável; NÃO duplique '$' para '$$').
TRAEFIK_DASHBOARD_AUTH=
DJANGO_LOG_LEVEL=INFO

# Evolution API — Postgres e Redis próprios (não é o mesmo Postgres do app)
EVOLUTION_POSTGRES_PASSWORD=troque-esta-senha
EVOLUTION_REDIS_PASSWORD=troque-esta-senha
# Igual ao valor de EVOLUTION_API_KEY acima — usado pelo próprio evolution-api
# para validar requisições (header apikey).
EVOLUTION_AUTHENTICATION_API_KEY=
# S3/MinIO para mídia de instância (auditado do EasyPanel: minio.tonicoimbra.com)
EVOLUTION_S3_ENDPOINT=minio.tonicoimbra.com
EVOLUTION_S3_BUCKET=evolution
EVOLUTION_S3_ACCESS_KEY=
EVOLUTION_S3_SECRET_KEY=

# --- Monitoramento (stack OPCIONAL: monitoring-stack.yml) ---
GRAFANA_DOMAIN=grafana.<DOMAIN>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha-do-grafana
PROMETHEUS_RETENTION=15d
# Loki exige múltiplo de 24h (360h = 15 dias).
LOKI_RETENTION=360h

# Servidor MCP oficial do Grafana (serviço grafana-mcp).
MCP_DOMAIN=mcp.<DOMAIN>
# Token server-side de um Service Account Viewer do Grafana.
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...
# htpasswd -nbB user senha; mantenha cada "$" SIMPLES no .env.
MCP_BASICAUTH_USERS=user:$2y$05$...

# Preenchido automaticamente pelos scripts com monitoring/ em caminho absoluto.
MONITORING_CONFIG_DIR=

# --- MCP administrativo do Django (OPCIONAL; endpoint /mcp) ---
DJANGO_MCP_ENDPOINT=mcp
DJANGO_MCP_SERVER_NAME=noivas-cia-admin
DJANGO_MCP_STATELESS=True
